            const leads = JSON.parse(localStorage.getItem('ayglobe_leads')) || [];\
            const name = document.getElementById('lead-name')?.value || 'Inquiry Client';\
            const email = document.getElementById('lead-email')?.value || 'client@company.com';\
            \
            leads.push(\{ name, email, date: new Date().toLocaleDateString() \});\
            localStorage.setItem('ayglobe_leads', JSON.stringify(leads));\
            \
            const resp = document.getElementById('contactFormResp');\
            if(resp) resp.innerText = "\uc0\u10003  Inquiry submitted! Stored in Admin Portal.";\
            closeConsultationModal();\
        \}\
\
        function renderLeads() \{\
            const leads = JSON.parse(localStorage.getItem('ayglobe_leads')) || [];\
            const container = document.getElementById('leadsContainer');\
            if(leads.length === 0) \{\
                container.innerHTML = "<p class='text-slate-400'>No submission leads yet.</p>";\
            \} else \{\
                container.innerHTML = leads.map(l => `<div class='p-2 bg-slate-100 rounded border flex justify-between'><span><b>$\{l.name\}</b> ($\{l.email\})</span><span class='text-slate-400'>$\{l.date\}</span></div>`).join('');\
            \}\
        \}\
\
        // App Init\
        window.addEventListener('load', () => \{\
            loadDynamicContent();\
            \
            const ctx = document.getElementById('heroChart').getContext('2d');\
            new Chart(ctx, \{\
                type: 'line',\
                data: \{\
                    labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'],\
                    datasets: [\{\
                        label: 'Pipeline Value ($)',\
                        data: [180000, 240000, 310000, 390000, 420000, 482500],\
                        borderColor: '#0056D2',\
                        backgroundColor: 'rgba(0, 86, 210, 0.15)',\
                        fill: true,\
                        tension: 0.4\
                    \}]\
                \},\
                options: \{\
                    responsive: true,\
                    maintainAspectRatio: false,\
                    plugins: \{ legend: \{ display: false \} \},\
                    scales: \{ x: \{ display: false \}, y: \{ display: false \} \}\
                \}\
            \});\
        \});\
    </script>\
</body>\
</html>}